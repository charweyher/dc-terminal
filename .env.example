# Copy to .env (gitignored) and fill in.
# Free key: https://www.eia.gov/opendata/register.php — used only by `npm run ingest:eia`.
EIA_API_KEY=

# --- Public site settings (inlined at build time; set these in Cloudflare Pages → Settings → Variables) ---
# Canonical URL used for the sitemap, robots.txt and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://dc-terminal.pages.dev
# beehiiv subscribe-form embed: the iframe's full src, e.g. https://embeds.beehiiv.com/<uuid>?slim=true
NEXT_PUBLIC_BEEHIIV_EMBED_URL=
# Fallback link when no embed is set, e.g. https://<publication>.beehiiv.com/subscribe
NEXT_PUBLIC_NEWSLETTER_URL=
# Optional public contact address shown in the footer
NEXT_PUBLIC_CONTACT_EMAIL=
